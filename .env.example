# ==============================================================================
# SentinelLog Environment Configuration Template
# Copy this file to .env for local customization. Never commit real secrets.
# ==============================================================================

# Ingestion settings
SENTINEL_DEFAULT_LOG_FILE=logs/sample.log
SENTINEL_MAX_FILE_SIZE_BYTES=52428800
SENTINEL_MAX_LINE_LENGTH=4096

# Detection thresholds
SENTINEL_FAILED_LOGIN_THRESHOLD=3
SENTINEL_FAILED_LOGIN_WINDOW_MINUTES=5
SENTINEL_CORRELATION_WINDOW_MINUTES=5

# Web Server & API
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8000
